          "key": "A",
          "text": "8:35"
        },
        {
          "key": "B",
          "text": "8:40"
        },
        {
          "key": "C",
          "text": "8:20"
        },
        {
          "key": "D",
          "text": "8:15"
        },
        {
          "key": "E",
          "text": "8:25"
