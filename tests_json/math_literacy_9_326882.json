        {
          "key": "B",
          "text": "32"
        },
        {
          "key": "C",
          "text": "27"
        },
        {
          "key": "D",
          "text": "8"
        },
        {
          "key": "E",
          "text": "16"
        }
      ],
      "correct_answer": "E",
      "answer_source": "official_key",
      "explanation": "(a + c) - (b + c) = 4 - 2 => a - b = 2. Сонда (a - b)^4 = 2^4 = 16."
